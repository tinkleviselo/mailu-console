# Mailu 部署参数示例（安装脚本会把实际参数写入 /etc/mailu-deploy/mailu-deploy.conf）
# 用法: . /etc/mailu-deploy/mailu-deploy.conf && bash install.sh --upgrade --yes

MAILU_DOMAIN='example.com'
MAILU_HOSTNAMES='mail.example.com'
MAILU_TLS='letsencrypt'
MAILU_ADMIN_USER='admin'
MAILU_ADMIN_PASS='REPLACE_WITH_STRONG_PASSWORD'
MAILU_API_TOKEN='REPLACE_WITH_RANDOM_TOKEN'
MAILU_API='true'
MAILU_ADMIN_GUI='true'
MAILU_WEBMAIL='snappymail'
MAILU_VERSION='2024.06.61'
MAILU_ROOT='/mailu'
MAILU_SUBNET='192.168.203.0/24'
MAILU_SECRET_KEY='REPLACE_WITH_32_RANDOM_CHARS'
MAILU_SITE_NAME='企业邮箱'
MAILU_TIMEZONE='Asia/Shanghai'
MAILU_MIRROR_PREFIX=''
MAILU_BIND_ADDRESS4='0.0.0.0'
MAILU_MESSAGE_SIZE_LIMIT='52428800'
MAILU_MESSAGE_RATELIMIT='200/day'
MAILU_CERTBOT_EMAIL='admin@example.com'
MAILU_BACKUP_DIR='/var/backups/mailu'
MAILU_DEFAULT_QUOTA_MB='2048'
MAILU_DOCKER_ORG='ghcr.io/mailu'
MAILU_FIREWALL_MANAGER='auto'
MAILU_CONFIGURE_FIREWALL='yes'
MAILU_INSTALL_DOCKER='yes'