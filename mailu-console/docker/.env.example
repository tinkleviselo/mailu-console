# 中台容器部署环境变量（复制为 .env 后修改）
MC_DOMAIN=console.example.com
MC_APP_NAME=Mailu 邮件中台

# 管理员（首次启动自动创建）
MC_ADMIN_USER=admin
MC_ADMIN_PASS=ChangeMe123456
MC_ADMIN_EMAIL=admin@example.com

# 数据库：sqlite（默认，零配置）或 mysql（需 --profile mysql 启动 db 服务）
MC_DB_DRIVER=sqlite
MC_DB_DATABASE=mailu.sqlite
# MC_DB_DRIVER=mysql
# MC_DB_HOST=db
# MC_DB_NAME=mailu_console
# MC_DB_USER=mailu
# MC_DB_PASS=changeme

MC_TIMEZONE=Asia/Shanghai
MC_MAILU_VERSION=2024.06.61

# 附加安装参数（例如 "--wait-db=60"）
MC_INSTALL_ARGS=--wait-db=60