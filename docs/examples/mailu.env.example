# ---------------------------------------------------------------------------
# Mailu 主配置文件（示例；实际文件为 /mailu/mailu.env，权限 600）
# 参考文档: https://mailu.io/configuration.html
# 修改后执行: cd /mailu && docker compose up -d
# ---------------------------------------------------------------------------

###################################
# 基础配置
###################################
SECRET_KEY=<openssl rand -hex 16 自动生成，勿泄露>
SUBNET=192.168.203.0/24
DOMAIN=example.com
HOSTNAMES=mail.example.com
POSTMASTER=postmaster
TLS_FLAVOR=letsencrypt

AUTH_RATELIMIT_IP=50
AUTH_RATELIMIT_USER=100
DISABLE_STATISTICS=True

###################################
# 功能开关
###################################
ADMIN=true
WEBMAIL=snappymail
API=true
WEBDAV=none
ANTIVIRUS=none
SCAN_MACROS=false
FETCHMAIL_ENABLED=false

###################################
# 邮件参数
###################################
MESSAGE_SIZE_LIMIT=52428800
MESSAGE_RATELIMIT=200/day
RELAYNETS=
RELAYHOST=
FETCHMAIL_DELAY=600
RECIPIENT_DELIMITER=+
DMARC_RUA=postmaster
DMARC_RUF=postmaster
DMARC_SEND_REPORTS=false
WELCOME=false
WELCOME_SUBJECT="欢迎使用企业邮箱"
WELCOME_BODY="您的邮箱已开通，请使用本邮件中的账号密码登录网页邮箱。"
COMPRESSION=
COMPRESSION_LEVEL=6
FULL_TEXT_SEARCH=en

###################################
# 网页配置
###################################
WEBROOT_REDIRECT=/webmail
WEB_ADMIN=/admin
WEB_WEBMAIL=/webmail
WEB_API=/api
SITENAME="企业邮箱"
WEBSITE="https://example.com"

###################################
# 高级配置
###################################
COMPOSE_PROJECT_NAME=mailu
CREDENTIAL_ROUNDS=12
REAL_IP_HEADER=
REAL_IP_FROM=
REJECT_UNLISTED_RECIPIENT=yes
LOG_LEVEL=INFO
TZ=Asia/Shanghai
DEFAULT_SPAM_THRESHOLD=80

# REST API 访问令牌（中台/自动化系统使用，至少 3 个字符）
API_TOKEN=<部署脚本自动生成的 API 令牌>
FULL_TEXT_SEARCH_ATTACHMENTS=false
